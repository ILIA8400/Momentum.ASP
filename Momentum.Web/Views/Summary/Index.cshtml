@model SummaryVm
@{
    Layout = null;
    var rows = Model.Stats.BySubject;
    Func<string, string> dash = v => string.IsNullOrEmpty(v) ? "<span style=\"color:var(--muted)\">—</span>" : v;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Momentum — جدول خلاصهٔ هفته</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --ink: #111827; --ink-2: #4b5563; --muted: #9ca3af; --line: #e5e7eb; --soft: #f3f4f6; --primary: #2563eb; --ok: #16a34a; --danger: #dc2626; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #e5e7eb; color: var(--ink); font-family: Vazirmatn, "Segoe UI", Tahoma, sans-serif; font-size: 13px; line-height: 1.6; }
        .toolbar { position: sticky; top: 0; background: #111827; color: #fff; padding: 10px 20px; display: flex; gap: 10px; align-items: center; z-index: 5; }
        .toolbar button, .toolbar a { background: var(--primary); color: #fff; border: 0; border-radius: 8px; padding: 8px 16px; font: inherit; cursor: pointer; text-decoration: none; }
        .toolbar .ghost { background: transparent; border: 1px solid rgba(255,255,255,.3); }
        .toolbar .sp { flex: 1; }
        .toolbar small { opacity: .7; }
        .page { background: #fff; width: 210mm; margin: 20px auto; padding: 14mm 12mm; box-shadow: 0 10px 40px rgba(0,0,0,.2); }
        .head { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 14px; }
        h1 { margin: 0; font-size: 20px; }
        .brand { font-size: 11px; color: var(--muted); letter-spacing: 2px; }
        .meta { color: var(--ink-2); font-size: 12px; text-align: left; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 7px 8px; border: 1px solid var(--line); text-align: right; }
        th { background: var(--soft); font-size: 11.5px; color: var(--ink-2); font-weight: 600; }
        th.n, td.n { text-align: center; direction: ltr; font-variant-numeric: tabular-nums; white-space: nowrap; }
        tr.total td { background: var(--soft); font-weight: 800; }
        .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-inline-end: 6px; vertical-align: middle; }
        .pct.good { color: var(--ok); font-weight: 700; } .pct.bad { color: var(--danger); font-weight: 700; }
        .sub { color: var(--ink-2); font-size: 12px; margin: 10px 0 0; }
        .empty { color: var(--muted); text-align: center; padding: 30px; }
        .foot { margin-top: 14px; color: var(--muted); font-size: 11px; display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 6px; }
        @@page { size: A4 landscape; margin: 10mm; }
        @@media print { body { background: #fff; } .toolbar { display: none; } .page { width: auto; margin: 0; padding: 0; box-shadow: none; } }
    </style>
</head>
<body>
    <div class="toolbar">
        <button onclick="window.print()">🖨️ چاپ / ذخیره PDF</button>
        <a class="ghost" href="/Summary?date=@Jalali.AddDays(Model.Start, -7)">‹ هفتهٔ قبل</a>
        <a class="ghost" href="/Summary?date=@Jalali.AddDays(Model.Start, 7)">هفتهٔ بعد ›</a>
        <a class="ghost" href="/Report?date=@Model.Start">گزارش کامل (All Plan)</a>
        <span class="sp"></span>
        <small>در پنجرهٔ چاپ، مقصد را «Save as PDF» بگذار</small>
    </div>
    <div class="page">
        <div class="head">
            <div>
                <div class="brand">MOMENTUM · خلاصهٔ هفته</div>
                <h1>هفتهٔ @Fa.FmtShort(Model.Start) تا @Fa.FmtDate(Model.End)</h1>
            </div>
            <div class="meta">
                @if (!string.IsNullOrWhiteSpace(Model.UserName))
                {
                    @Html.Raw((Model.UserName) + "<br>")
                }
                @Fa.D(Model.Days) روز مطالعه · @Fa.D(Model.Entries.Count) جلسه
            </div>
        </div>
        @if (rows.Count > 0)
        {
            var sum = new { count = rows.Sum(r => r.Count), minutes = rows.Sum(r => r.Minutes), study = rows.Sum(r => r.StudyMin), review = rows.Sum(r => r.ReviewMin), test = rows.Sum(r => r.TestMin), tests = rows.Sum(r => r.Tests), correct = rows.Sum(r => r.Correct), wrong = rows.Sum(r => r.Wrong) };
            <table>
                <thead>
                    <tr>
                        <th>درس</th><th class="n">جلسه</th><th class="n">مطالعهٔ کل</th><th class="n">خواندن</th><th class="n">مرور</th>
                        <th class="n">تست زدن</th><th class="n">تعداد تست</th><th class="n">درست</th><th class="n">غلط</th><th class="n">درصد</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td><span class="dot" style="background:@r.Color"></span>@(r.Name)</td>
                            <td class="n">@Fa.D(r.Count)</td>
                            <td class="n"><b>@Fa.Hmc(r.Minutes)</b></td>
                            <td class="n">@(r.StudyMin > 0 ? Fa.Hmc(r.StudyMin) : "—")</td>
                            <td class="n">@(r.ReviewMin > 0 ? Fa.Hmc(r.ReviewMin) : "—")</td>
                            <td class="n">@(r.TestMin > 0 ? Fa.Hmc(r.TestMin) : "—")</td>
                            <td class="n">@(r.Tests > 0 ? Fa.D(r.Tests) : "—")</td>
                            <td class="n">@(r.Correct > 0 ? Fa.D(r.Correct) : "—")</td>
                            <td class="n">@(r.Wrong > 0 ? Fa.D(r.Wrong) : "—")</td>
                            <td class="n">
                                @if (r.Percent != null)
                                {
                                    <span class="pct @(r.Percent >= 50 ? "good" : r.Percent < 20 ? "bad" : "")">@Fa.D(r.Percent)٪</span>
                                }
                                else
                                {
                                    <span style="color:var(--muted)">—</span>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="total">
                        <td>جمع هفته</td>
                        <td class="n">@Fa.D(sum.count)</td>
                        <td class="n">@Fa.Hmc(sum.minutes)</td>
                        <td class="n">@Fa.Hmc(sum.study)</td>
                        <td class="n">@Fa.Hmc(sum.review)</td>
                        <td class="n">@Fa.Hmc(sum.test)</td>
                        <td class="n">@Fa.D(sum.tests)</td>
                        <td class="n">@Fa.D(sum.correct)</td>
                        <td class="n">@Fa.D(sum.wrong)</td>
                        <td class="n">
                            @if (Model.Stats.Percent != null)
                            {
                                <span class="pct @(Model.Stats.Percent >= 50 ? "good" : Model.Stats.Percent < 20 ? "bad" : "")">@Fa.D(Model.Stats.Percent)٪</span>
                            }
                            else
                            {
                                <span style="color:var(--muted)">—</span>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            <p class="sub">زمان‌ها به صورت ساعت:دقیقه · درصد با نمرهٔ منفی: (۳×درست − غلط) ÷ (۳×کل)</p>
        }
        else
        {
            <div class="empty">این هفته چیزی ثبت نشده</div>
        }
        <div class="foot"><span>Momentum</span><span>@Fa.FmtDate(Jalali.TodayJalali())</span></div>
    </div>
</body>
</html>
